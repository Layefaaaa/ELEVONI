# Copy to frontend/.env and fill in real values. Only VITE_ variables reach the browser.

# Base URL of the backend API, without a trailing slash.
# Leave unset to use the production API.
VITE_API_BASE_URL=https://elevoni-backend.vercel.app

# Public Google OAuth Web Client ID; safe to expose in the browser
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Public Paystack key used to open the payment window; safe to expose in the browser
VITE_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
